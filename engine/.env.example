# Required
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=0

# Wake + confirm
WAKE_THRESHOLD=0.35
CONFIRM_WAKEUP=1
WAKEUP_PHRASE=wake up
STT_MODEL=tiny.en
WAKEUP_WINDOW=3.0

# Playback
JARVIS_SPEED=1.2
JARVIS_VOLUME=1.0

# Speech backend order (see README.md):
#   1. JARVIS_POCKET_*   local cloned-voice server (optional)
#   2. GEMINI_API_KEY    Google Gemini TTS (optional)
#   3. Windows SAPI      built-in fallback voice (always available)
# OpenTTS server is NOT required on Windows — SAPI covers it.
# OPENTTS_URL=http://localhost:5500
# OPENTTS_VOICE=en_US-amy-medium

# Optional
# GEMINI_API_KEY=
# JARVIS_POCKET_VOICE=
# JARVIS_POCKET_URL=http://localhost:8000
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe